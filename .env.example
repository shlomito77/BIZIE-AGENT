# ============================================
# BIZIE Environment Variables
# ============================================

# ⚠️ IMPORTANT: Copy this file to .env.local and add real values
# Never commit .env.local to git!

# --------------------------------------------
# Backend Configuration (Vercel/Server)
# --------------------------------------------

# Gemini AI API Key (SERVER-SIDE ONLY!)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres connection string (Vercel/Neon)
POSTGRES_URL=postgresql://user:pass@host:5432/dbname

# Google Sign-In (server)
GOOGLE_CLIENT_ID=your_google_client_id_here
ALLOWED_ADMIN_EMAILS=you@example.com,admin@example.com

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Basic Auth (required for all API routes)
BASIC_AUTH_USER=your_admin_user
BASIC_AUTH_PASS=your_strong_password

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_SECRET_TOKEN=your_telegram_webhook_secret

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Monitoring (Sentry)
SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_DSN=your_sentry_dsn

# --------------------------------------------
# Frontend Configuration (Optional)
# --------------------------------------------

# Google Calendar Client ID (if using calendar)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
